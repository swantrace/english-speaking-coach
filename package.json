{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "dev": "turbo run dev",
    "dev:agent": "turbo run dev --filter=assistant",
    "dev:agent:docker": "docker compose --profile agent up agent",
    "agent:download-files": "pnpm --filter agent download-files",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:logs:agent": "docker compose logs -f agent",
    "dev:backend:api": "turbo run dev:api --filter=@english-coach/backend",
    "dev:backend:worker": "turbo run dev:worker --filter=@english-coach/backend",
    "dev:backend": "pnpm dev:backend:api",
    "dev:full": "pnpm infra:up && concurrently -k -n web,api,worker -c cyan,blue,green \"pnpm --filter web dev\" \"pnpm dev:backend:api\" \"pnpm dev:backend:worker\"",
    "dev:full:agent": "pnpm infra:up && concurrently -k -n web,api,worker,agent -c cyan,blue,green,magenta \"pnpm --filter web dev\" \"pnpm dev:backend:api\" \"pnpm dev:backend:worker\" \"pnpm dev:agent\"",
    "dev:development": "sh scripts/dev-profile.sh development",
    "dev:practice": "sh scripts/dev-profile.sh practice",
    "db:clear:app": "turbo run db:clear:app --filter=@english-coach/database",
    "db:clear": "turbo run db:clear --filter=@english-coach/database",
    "db:generate": "turbo run db:generate --filter=@english-coach/database",
    "db:push": "turbo run db:push --filter=@english-coach/database",
    "format-and-lint": "biome check --error-on-warnings .",
    "format-and-lint:fix": "biome check . --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@livekit/agents": "^1.6.0",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "name": "english-speaking-coach"
}
