{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:agent": "turbo run dev --filter=agent",
    "dev:agent:docker": "docker compose --profile agent up agent",
    "agent:download-files": "pnpm --filter agent download-files",
    "test:agent": "pnpm --filter agent test",
    "infra:up": "docker compose up -d",
    "infra:up:agent": "docker compose --profile agent up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:logs:agent": "docker compose logs -f agent",
    "dev:backend:api": "turbo run dev:api --filter=backend",
    "dev:backend:worker": "turbo run dev:worker --filter=backend",
    "dev:backend": "pnpm dev:backend:api",
    "dev:full": "pnpm infra:up && concurrently -k -n web,api,agent -c cyan,blue,green \"pnpm --filter web dev\" \"pnpm dev:backend:api\" \"pnpm dev:agent\"",
    "db:generate": "turbo run db:generate --filter=@english-coach/database",
    "db:push": "turbo run db:push --filter=@english-coach/database",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "concurrently": "^9.2.1",
    "turbo": "^2.9.3"
  },
  "packageManager": "pnpm@10.30.3",
  "name": "english-speaking-coach"
}
