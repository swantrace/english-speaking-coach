{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "cd ../.. && pnpm exec turbo query affected --packages web --base=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" --head=\"${VERCEL_GIT_COMMIT_SHA:-HEAD}\" --exit-code",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://english-speaking-coach.fly.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
