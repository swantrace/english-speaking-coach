{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "cd ../.. && pnpm exec turbo query affected --packages web --exit-code",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://english-speaking-coach.fly.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
