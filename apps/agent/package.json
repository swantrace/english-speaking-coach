{
  "name": "assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "clean": "rm -rf dist",
    "dev": "pnpm run build && pnpm exec concurrently -k -n build,agent -c yellow,green \"pnpm run build:watch\" \"pnpm exec nodemon --watch dist --ext js,mjs --signal SIGTERM --exec 'node dist/main.js dev'\"",
    "download-files": "pnpm run build && node dist/main.js download-files",
    "start": "pnpm run build && node dist/main.js start",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@english-coach/contract": "workspace:*",
    "@english-coach/prompts": "workspace:*",
    "@livekit/agents": "^1.6.0",
    "@livekit/agents-plugin-cartesia": "^1.6.0",
    "@livekit/agents-plugin-deepgram": "^1.6.0",
    "@livekit/agents-plugin-openai": "^1.6.0",
    "@livekit/agents-plugin-silero": "^1.6.0",
    "@livekit/noise-cancellation-node": "^0.2.0",
    "@livekit/rtc-node": "^0.13.32",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
