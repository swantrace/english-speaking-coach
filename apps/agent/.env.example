# LiveKit connection. Use the development credentials below with the local
# Docker server, or replace all three values with LiveKit Cloud credentials.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Model integration:
# - plugins: call DeepSeek, Deepgram, and Cartesia directly (keys required below)
# - livekit: use LiveKit Inference (the provider keys below are not required)
AGENT_MODEL_PROVIDER=plugins
NODE_ENV=development

# Internal connections. API_TOKEN must match the backend value. It may be left
# empty during development, when both services use the built-in local default.
BACKEND_BASE_URL=http://localhost:3001
API_TOKEN=
REDIS_URL=redis://localhost:6379

# Required only when AGENT_MODEL_PROVIDER=plugins.
DEEPSEEK_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Optional voice and coaching controls.
CARTESIA_VOICE_ID=a167e0f3-df7e-4d52-a9c3-f949145efdab
# IN_CONVERSATION_ANALYSIS_TURN_COUNT=4
# ERROR_LOG_DIR=
