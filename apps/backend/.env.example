# Runtime profile: development, practice, or test.
APP_ENV=development
NODE_ENV=development
PORT=3001
MIGRATE_ON_STARTUP=true
# BUN_IDLE_TIMEOUT_SECONDS=60

# Local development (resolved from apps/backend):
TURSO_DATABASE_URL=file:../../data/coach.sqlite
TURSO_AUTH_TOKEN=
#
# Shared practice: libsql://<database-name>-<organization>.turso.io
# TURSO_DATABASE_URL=libsql://<database-name>-<organization>.turso.io
# TURSO_AUTH_TOKEN=<turso-auth-token>

# Local development: redis://localhost:6379
# Shared practice: copy the TLS URL supplied by Upstash.
REDIS_URL=redis://localhost:6379

# Better Auth. Use a random secret of at least 32 characters outside local
# development. In practice, BETTER_AUTH_URL is the browser-facing Vercel origin
# because Vercel proxies /api to Fly.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Shared secret for backend-to-Agent requests. It must match the Agent value.
# Development may leave this empty to use the built-in local default.
API_TOKEN=

# S3-compatible storage.
# MinIO development example:
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=english-coach-development
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
#
# Cloudflare R2 shared-practice values:
# S3_PROVIDER=r2
# S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=english-coach-practice
# S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# S3_FORCE_PATH_STYLE=false

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LIVEKIT_TOKEN_TTL=6h

# Provider credentials for asynchronous generation and analysis. A key is
# required only when at least one route below selects that provider.
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Recommended asynchronous routing. Every provider/model can be overridden independently.
KNOWLEDGE_GENERATE_PROVIDER_ID=openai
KNOWLEDGE_GENERATE_MODEL=gpt-5.6-terra

LING_ANALYSIS_PROVIDER_ID=openai
LING_ANALYSIS_MODEL=gpt-5.6-sol

CONVERSATION_ANALYSIS_PROVIDER_ID=deepseek
CONVERSATION_ANALYSIS_MODEL=deepseek-v4-flash

# Scenario generation can use one provider or mix providers step by step.
SCENARIO_STORY_PROVIDER_ID=qwen
SCENARIO_STORY_MODEL=qwen3.7-plus
SCENARIO_GOALS_PROVIDER_ID=openai
SCENARIO_GOALS_MODEL=gpt-5.6-terra
SCENARIO_DIALOGUE_PROVIDER_ID=qwen
SCENARIO_DIALOGUE_MODEL=qwen3.7-plus

# Optional queue, streaming, and diagnostics tuning.
# KNOWLEDGE_GENERATE_PROGRESS_CHANNEL=knowledge.generate.progress
# SCENARIO_GENERATE_PROGRESS_CHANNEL=scenario.generate.progress
# KNOWLEDGE_GENERATE_SSE_MAX_DURATION_MS=300000
# SCENARIO_GENERATE_SSE_MAX_DURATION_MS=300000
# ERROR_LOG_DIR=
