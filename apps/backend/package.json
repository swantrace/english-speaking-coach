{
  "name": "@english-coach/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./auth": "./src/lib/auth.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && bun build ./src/api.ts ./src/worker.ts --outdir ./dist --target bun",
    "dev:api": "bun --env-file=.env.local --watch ./src/api.ts",
    "dev:worker": "bun --env-file=.env.local --hot ./src/worker.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "start": "concurrently -k -n api,worker \"bun run ./src/api.ts\" \"bun run ./src/worker.ts\"",
    "start:api": "bun run ./src/api.ts",
    "start:worker": "bun run ./src/worker.ts",
    "test": "REDIS_DB=15 bun test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.23",
    "@ai-sdk/openai-compatible": "^3.0.16",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@cartesia/cartesia-js": "^3.5.1",
    "@english-coach/contract": "workspace:*",
    "@english-coach/database": "workspace:*",
    "@english-coach/prompts": "workspace:*",
    "@english-coach/storage": "workspace:*",
    "ai": "^7.0.41",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.2",
    "concurrently": "^10.0.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.17.0",
    "openai": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@english-coach/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  }
}
