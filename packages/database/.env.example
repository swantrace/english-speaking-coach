APP_ENV=development
# This path is resolved when database commands run from packages/database.
TURSO_DATABASE_URL=file:../../data/coach.sqlite
TURSO_AUTH_TOKEN=

# For shared practice, use APP_ENV=practice and replace the values above:
# TURSO_DATABASE_URL=libsql://<database-name>-<organization>.turso.io
# TURSO_AUTH_TOKEN=<turso-auth-token>
