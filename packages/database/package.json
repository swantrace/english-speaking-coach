{
  "name": "@english-coach/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:clear:app": "bun run ./src/clear-app.ts",
    "db:clear": "bun run ./src/clear.ts && drizzle-kit generate && bun run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun -e \"import { migrateDatabase } from './src/index.ts'; await migrateDatabase(); console.log('migrations applied');\"",
    "db:push": "drizzle-kit push",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@english-coach/domain": "workspace:*",
    "@english-coach/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.6",
    "eslint": "^8.57.0",
    "typescript": "7.0.2"
  }
}
