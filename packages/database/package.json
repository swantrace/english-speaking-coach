{
  "name": "@english-coach/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:clear:app": "bun run ./src/clear-app.ts",
    "db:clear": "bun run ./src/clear.ts && drizzle-kit generate && bun run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun -e \"import { migrateDatabase } from './src/index.ts'; migrateDatabase(); console.log('migrations applied');\"",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@english-coach/domain": "workspace:*",
    "@english-coach/typescript-config": "workspace:*",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.12.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^8.57.0",
    "typescript": "5.9.3"
  }
}
